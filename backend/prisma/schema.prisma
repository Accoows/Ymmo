generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Superadmin
  Admin
  AgencyHead
  User
}

model user {
  id        String   @id @default(uuid())
  role      Role     @default(User)
  email     String   @unique
  password  String
  username  String   @unique
  firstName String
  lastName  String
  createdAt DateTime @default(now())
}

model property {
  id           String   @id @default(uuid())
  name         String
  description  String
  photos       media[]
  typeId       Int
  localisation String
  price        Decimal
  surface      Int
  bedroom      Int
  bathroom     Int
  garage       Int
  details      Json?
  posted_at    DateTime @default(now())

  type propertyType @relation(fields: [typeId], references: [id])
}

model media {
  id         String @id @default(uuid())
  path       String
  propertyId String

  property property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model propertyType {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  properties property[]
}

model contactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  propertyId String?
  createdAt DateTime @default(now())
}
